{
  "name": "two-tier-relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Gasless EIP-712 intent relayer for Two-Tier Money",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fund-check": "tsx scripts/fund-check.ts",
    "send-intent": "tsx scripts/send-intent.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.0.0",
    "viem": "^2.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
