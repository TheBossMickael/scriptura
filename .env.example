# Two-Tier Money Sandbox — environment template (copy to .env, never commit .env)
#
# No HD mnemonic on purpose: a single seed is the maximal root secret AND would let the
# backend derive (and impersonate) the clients' keys, breaking "the EOA decides". Instead
# we keep individual keys for the server-signing roles, and ADDRESSES ONLY for clients.
#
# The values below are Anvil's well-known PUBLIC test keys (default mnemonic) — perfect
# for local dev, NEVER for Sepolia. For Sepolia: replace the operator keys (ideally via an
# encrypted Foundry keystore) and put real addresses for the clients (their keys stay in
# MetaMask, never here).

# --- Server signing keys (broadcast during deploy/seed; vm.envUint in the scripts) ---
# The StableCo operator joined this set in Phase 4: it signs the StableCo deployment and
# pause()/unpause(), so it is now a server-signing role with its own *_PK (its address is
# still Anvil index 3, 0x90F7…b906, exactly the key below).
CENTRAL_BANK_OPERATOR_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BANK_A_OPERATOR_PK=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BANK_B_OPERATOR_PK=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
STABLECO_OPERATOR_PK=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# --- Relayer (long-running service): its own gas-only key + matching address ---
# RELAYER_ADDRESS must equal the address of RELAYER_PK (the relayer checks this at boot).
# The deploy scripts only need the ADDRESS (to fund + record it); the key stays with the
# relayer service alone.
RELAYER_PK=0xdbda1821b80551c9d65939329250298aa3472ba22feea921c0cf5d620ea67b97
RELAYER_ADDRESS=0x23618e81E3f5cdF7f54C3d65f7FBc0aBf5B21E8f

# --- Client ADDRESSES (no client private keys in prod) ---
ALICE1_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
ALICE2_ADDRESS=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
BOB1_ADDRESS=0x976EA74026E726554dB657fA54763abd0C3a0aa9
BOB2_ADDRESS=0x14dC79964da2C08b23698B3D3cc7Ca32193d9955

# --- TEST ONLY: a client key for the local smoke script (relayer/scripts/send-intent.ts).
#     Public Anvil key for alice1. NEVER put a real client private key here. ---
ALICE1_PK=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# --- Chain / relayer config ---
# Target chain for the relayer / fund-check: local | sepolia
# (named CHAIN_NAME because foundry binaries auto-load .env and a CHAIN variable would
# collide with cast/forge's --chain flag)
CHAIN_NAME=local

# Sepolia RPC endpoint (Alchemy/Infura/...) — required for deploy-sepolia and CHAIN_NAME=sepolia
SEPOLIA_RPC_URL=""

# Relayer HTTP port (host side)
RELAYER_PORT=3001

# Relayer gas-balance alert threshold, in ether (fund-check + periodic watcher)
MIN_RELAYER_BALANCE="0.02"

# Option B public onboarding: test euros credited per /faucet onboard (whole units, 6
# decimals applied by the relayer). Capped on-chain by CommercialBank.MAX_FAUCET_CREDIT.
FAUCET_AMOUNT="100000"

# --- Frontend (Vite, browser-facing) ---
# Read from THIS root .env (vite envDir points here). Defaults target the local dev stack;
# only override for Sepolia / hosting (Phase 6). The browser reaches these host-published ports.
VITE_RELAYER_URL="http://localhost:3001"
VITE_PONDER_URL="http://localhost:42069"

# --- Indexer (Ponder) ---
# Local dev needs nothing (CHAIN_NAME=local + Anvil default RPC). For Sepolia, set
# CHAIN_NAME=sepolia (+ SEPOLIA_RPC_URL above); PONDER_RPC_URL overrides the RPC if set.
